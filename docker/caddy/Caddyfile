# Phase 2 Caddyfile — 로컬/스테이징 기본형.
# 본격적인 CSP/보안 헤더(docs/research/backend/05_auth_security.md §3.5)는
# docs/plan/01_be.md M3 단계에서 채워 넣는다.
{
    admin off
    auto_https off
}

:80 {
    encode zstd gzip

    # PWA 정적 파일 (FE dist) — Phase 2 시점에는 빈 디렉터리 가능
    root * /srv

    # /api/* → BE upstream
    @api path /api/*
    handle @api {
        reverse_proxy be:8000 {
            transport http {
                keepalive 5s
                read_timeout 65s
                write_timeout 65s
            }
        }
    }

    # /health → BE
    handle /health {
        reverse_proxy be:8000
    }

    # SPA fallback
    handle {
        try_files {path} /index.html
        file_server
    }
}
