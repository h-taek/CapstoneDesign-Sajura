# 리버스 프록시 + PWA 정적 파일 (03_be.md §15.1).
# SITE_ADDRESS가 도메인이면 Caddy가 Let's Encrypt 인증서를 받아 HTTPS로 서빙한다(443만 열어도 TLS-ALPN으로 발급).
# 비우면 :80 평문 — 로컬 개발.
{
    admin off
}

(app) {
    encode zstd gzip
    root * /srv

    # /api/* → BE. FE 요청 제한 시간(업로드·예측 실행 120초)보다 길게
    @api path /api/*
    handle @api {
        reverse_proxy be:8000 {
            transport http {
                keepalive 5s
                read_timeout 130s
                write_timeout 130s
            }
        }
    }

    handle /health {
        reverse_proxy be:8000
    }

    # SPA fallback
    handle {
        try_files {path} /index.html
        file_server
    }
}

{$SITE_ADDRESS::80} {
    import app
}

# 컨테이너 안 healthcheck용 — 도메인을 쓸 때도 http://localhost/health가 응답하게
http://localhost {
    import app
}
