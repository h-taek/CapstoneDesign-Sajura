        "jsCode": "const b64 = (s) => (typeof Buffer !== 'undefined'\n  ? Buffer.from(s, 'utf8').toString('base64')\n  : btoa(unescape(encodeURIComponent(s))));\nconst job = $('작업 시작').first().json;\nconst rows = $input.first().json.predictions.map((p) => ({\n  target_date: p.target_date, horizon_days: p.horizon_days, predicted_sales: p.predicted_sales,\n  interval_p10: p.interval_p10, interval_p90: p.interval_p90,\n  is_low_confidence: p.is_low_confidence ? 1 : 0, low_confidence_reason: p.low_confidence_reason ?? null,\n  explanation: p.explanation ?? null, menu_forecast: p.menu_forecast ?? [],\n}));\nreturn [{ json: { job_id: job.job_id, store_id: job.store_id, payload: b64(JSON.stringify(rows)) } }];\n"
