      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO forecast_results\n  (forecast_id, store_id, target_date, horizon_days, predicted_sales, interval_p10, interval_p90,\n   is_low_confidence, low_confidence_reason, explanation, generated_at)\nSELECT UUID(), $1, jt.target_date, jt.horizon_days, jt.predicted_sales, jt.interval_p10, jt.interval_p90,\n       jt.is_low_confidence, jt.low_confidence_reason, jt.explanation, UTC_TIMESTAMP()\nFROM JSON_TABLE(CONVERT(FROM_BASE64($2) USING utf8mb4), '$[*]' COLUMNS (\n  target_date DATE PATH '$.target_date',\n  horizon_days INT PATH '$.horizon_days',\n  predicted_sales INT PATH '$.predicted_sales',\n  interval_p10 INT PATH '$.interval_p10',\n  interval_p90 INT PATH '$.interval_p90',\n  is_low_confidence TINYINT PATH '$.is_low_confidence',\n  low_confidence_reason VARCHAR(32) PATH '$.low_confidence_reason',\n  explanation JSON PATH '$.explanation'\n)) AS jt\nON DUPLICATE KEY UPDATE\n  horizon_days = VALUES(horizon_days), predicted_sales = VALUES(predicted_sales),\n  interval_p10 = VALUES(interval_p10), interval_p90 = VALUES(interval_p90),\n  is_low_confidence = VALUES(is_low_confidence), low_confidence_reason = VALUES(low_confidence_reason),\n  explanation = VALUES(explanation), generated_at = VALUES(generated_at)",
        "options": {
