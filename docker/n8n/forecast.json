      "parameters": {
        "jsCode": "const job = $('작업 시작').first().json;\nconst daily = $('일별 매출').all().map((i) => i.json).filter((r) => r.date);\nconst menus = $('메뉴별 판매').all().map((i) => i.json).filter((r) => r.date);\nconst last = daily.length ? daily[daily.length - 1].date : null;\nconst add = (d, n) => {\n  const t = new Date(`${d}T00:00:00Z`);\n  t.setUTCDate(t.getUTCDate() + n);\n  return t.toISOString().slice(0, 10);\n};\n// 외부 데이터(기상청 단기예보)는 서비스키를 받으면 붙인다 — 그 전에는 날씨 없이 예측한다\nconst weather = [];\nreturn [{ json: { body: {\n  store_id: job.store_id,\n  target_dates: last ? [1, 2, 3].map((n) => add(last, n)) : [],\n  sales_history: daily.map((r) => ({ date: r.date, total_amount: Number(r.total_amount), order_count: Number(r.order_count) })),\n  menu_sales_history: menus.map((r) => ({ date: r.date, menu_id: r.menu_id, quantity: Number(r.quantity) })),\n  weather,\n} } }];\n"
      },
