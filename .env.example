# ─── Application ───────────────────────────────
APP_ENV=development
APP_NAME=sajura-be
LOG_LEVEL=INFO

# ─── Database (MySQL) ──────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=sajura
DB_USER=app_user
DB_PASSWORD=change_me

# Local Docker MySQL bootstrap (docker/mysql/init.sh)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=sajura
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me

# ─── Redis (cache + ARQ broker + rate limit) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ─── OAuth (docs/spec/03_be.md §1, 03_be.md) ──
# dev: redirect_uri는 FE Vite proxy(5173) 경유 — same-origin 유지로 Safari ITP 쿠키 차단 회피.
#      OAuth 콘솔(Google/Kakao)의 승인된 redirect URI에도 동일 값을 등록해야 함.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/api/auth/callback/kakao
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback/google
# 매장 주소 → 좌표 변환(Google Geocoding API). 날씨 격자·관측소 계산용. 같은 GCP 프로젝트, API 키는 Geocoding API로 제한
GOOGLE_MAPS_API_KEY=
SESSION_SECRET=change_me_session_secret

# ─── JWT ───────────────────────────────────────
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# ─── AES-256-GCM (pos_connections.api_key, 03_be.md §10.1) ──
AES_GCM_KEY_BASE64=

# ─── 국세청 사업자등록 진위확인 (data.go.kr/odcloud, M3.B3) ──
# serviceKey 발급 후 STUB_MODE=false로 실연동. 미설정 시 stub(항상 ACTIVE).
NTS_API_SERVICE_KEY=
NTS_API_STUB_MODE=true
NTS_API_BASE_URL=https://api.odcloud.kr/api/nts-businessman/v1
# 강제 패스용 마스터 코드(시연/테스트). 입력 사업자번호가 이 값과 같으면 NTS 호출 없이 통과.
# 숫자만이면 FE 입력 마스크가 하이픈을 넣어 보내므로 NNN-NN-NNNNN 형태로 적는다(영문이 섞이면 마스크 없음).
NTS_MASTER_BYPASS_CODE=

# ─── VAPID (Web Push, 02_implementation_design.md §4.3.23, pywebpush) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ─── 메일 (fastapi-mail, 파기 증빙 이메일) ──────
# dev는 MAIL_SUPPRESS_SEND=true로 실제 발송 없이 기록만 남긴다. prod는 SMTP 계정을 넣고 false
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_SUPPRESS_SEND=true

# ─── Sentry (sentry-sdk[fastapi]) ──────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ─── External services ─────────────────────────
# AI Server는 n8n만 부른다(주소는 docker-compose.yml n8n 환경값)
N8N_BASE_URL=http://n8n:5678
# n8n ↔ BE 공유 비밀값 — 수동 예측 웹훅·예측 완료 알림 API(X-Internal-Token). 무작위 32바이트 이상
INTERNAL_API_TOKEN=
# n8n 예측 워크플로우 전용 DB 계정 (02_implementation_design.md §4.5, docker/mysql/n8n_user.sh)
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=
# 개발팀 Slack Incoming Webhook — 비면 배치 실패 알림 생략
SLACK_WEBHOOK_URL=
# 기상청 단기예보 조회서비스(공공데이터포털 15084084) 서비스키 — 일반 인증키 Decoding 값.
# n8n 예측 배치가 https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0 (대상일 예보)과
# https://apis.data.go.kr/1360000/AsosDalyInfoService (ASOS 일자료 15059093, 과거 관측)를 같은 키로 부른다
KMA_SERVICE_KEY=

# ─── LLM (쿠팡 자동 담기 상품 선택, 03_be.md §2.4) ──
# 개발·시연은 대회 게이트웨이(OpenAI 호환). 키 하나로 여러 회사 모델 — LLM_MODEL 이름만 바꾼다
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://gateway.aitestbed.kr/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-sol
LLM_REASONING_EFFORT=medium
# 보안 분류기(시연용, 03_be.md §2.4.3) — 요청 전체 승인·거부. 로컬 OpenAI 호환 서버(Ollama 등)
LLM_GUARD_ENABLED=false
LLM_GUARD_BASE_URL=http://host.docker.internal:11434/v1
LLM_GUARD_MODEL=qwen3.6:35b-a3b

# ─── CORS / TrustedHost (03_be.md §13.2-§13.3) ──
CORS_ALLOW_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,be
