# ─── Application ───────────────────────────────
APP_ENV=development
APP_NAME=sajura-be
LOG_LEVEL=INFO

# ─── Database (MySQL) ──────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=sajura
DB_USER=app_user
DB_PASSWORD=change_me

# Local Docker MySQL bootstrap (docker/mysql/init.sh)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=sajura
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me

# ─── Redis (cache + ARQ broker + rate limit) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ─── OAuth (spec/07_backend/service_design.md §1, security.md) ──
# dev: redirect_uri는 FE Vite proxy(5173) 경유 — same-origin 유지로 Safari ITP 쿠키 차단 회피.
#      OAuth 콘솔(Google/Kakao)의 승인된 redirect URI에도 동일 값을 등록해야 함.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/api/auth/callback/kakao
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback/google

# ─── JWT ───────────────────────────────────────
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# ─── AES-256-GCM (pos_connections.api_key, security.md §4.1) ──
AES_GCM_KEY_BASE64=

# ─── 국세청 사업자등록 진위확인 (data.go.kr/odcloud, M3.B3) ──
# serviceKey 발급 후 STUB_MODE=false로 실연동. 미설정 시 stub(항상 ACTIVE).
NTS_API_SERVICE_KEY=
NTS_API_STUB_MODE=true
NTS_API_BASE_URL=https://api.odcloud.kr/api/nts-businessman/v1
# 강제 패스용 마스터 코드(시연/테스트). 입력 사업자번호가 이 값과 같으면 NTS 호출 없이 통과.
NTS_MASTER_BYPASS_CODE=

# ─── VAPID (Web Push, schema.md §3.23, pywebpush) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ─── Sentry (sentry-sdk[fastapi]) ──────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ─── External services ─────────────────────────
AI_SERVER_BASE_URL=http://ai:8001
N8N_BASE_URL=http://n8n:5678

# ─── CORS / TrustedHost (service_design.md §10.2-10.3) ──
CORS_ALLOW_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,be
