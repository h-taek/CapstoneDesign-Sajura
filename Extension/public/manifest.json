{
  "manifest_version": 3,
  "name": "사주라 확장 (Sajura Extension)",
  "version": "0.1.0",
  "description": "사주라 발주 품목을 쿠팡 장바구니에 담습니다.",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["*://*.coupang.com/*"], "js": ["dialog.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["*://*.coupang.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "host_permissions": ["*://*.coupang.com/*"],
  "permissions": ["storage"],
  "externally_connectable": { "matches": ["http://localhost:5173/*"] }
}
